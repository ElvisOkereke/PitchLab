# ---- Worker / CLI (packages/core). The web app never reads the LLM or data-source keys. ----
LLM_API_KEY=
LLM_ANTHROPIC_BASE_URL=
LLM_OPENAI_BASE_URL=
# Default pglite://.data/pglite. For the dashboard + worker use the local Postgres from docker-compose.yml:
# postgres://bcg:bcg_local_dev@127.0.0.1:5433/bcg (local-only dev password), then copy once: npm run db:copy
# The web app accepts postgres:// or postgresql:// only. Free remote option: a Supabase SESSION POOLER string
# (docs/dashboard.md, "Free setup"). sslmode/ssl parameters in the URL are removed; the variables below decide TLS.
DATABASE_URL=
# Postgres TLS (web, worker and CLI): auto (default) = plain for localhost/127.0.0.1/::1/*.railway.internal and
# verified TLS for every other host; verify = always verified TLS; disable = plain. No mode skips certificate checks.
DATABASE_SSL=
# Absolute path to the PEM CA that verifies the database certificate (Supabase: the downloaded SSL certificate,
# kept OUTSIDE the repo), e.g. C:/Users/<you>/supabase/prod-ca-2021.crt. Used only when TLS is on.
DATABASE_SSL_CA=
# Connections per process, integer 1 to 20 (default: web 5, worker and each CLI command 4). Supabase's free session
# pooler allows about 15 in total.
DATABASE_POOL_MAX=
# Optional: a THROWAWAY Postgres for the real-Postgres tests (the tests write to it)
TEST_DATABASE_URL=
LLM_MAX_CONCURRENCY=
MODEL_OVERRIDES=
GITHUB_TOKEN=
STACKEXCHANGE_KEY=
GOOGLE_PLACES_API_KEY=
# Optional, for research missions: a Product Hunt developer token (free; sign in at https://www.producthunt.com/v2/oauth/applications,
# create an application, then use its Developer Token, not the API key or secret). The token is for non-commercial use: if PitchLab
# starts earning money, email hello@producthunt.com for commercial permission. Without it, research missions skip Product Hunt.
PRODUCTHUNT_TOKEN=

# ---- Dashboard (apps/web). Names only; never commit values. No NEXT_PUBLIC_* variables exist. ----
# The dashboard needs a postgres:// DATABASE_URL (above); PGlite cannot be shared with the worker.
# scrypt:N:r:p:salt:key from `npm run hash-password -w apps/web` (':' separators because .env expands $NAME)
OWNER_PASSWORD_HASH=
# >= 32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating it logs out every device.
SESSION_SECRET=
# Reverse proxies whose X-Forwarded-For entry is trusted for the login rate limit, integer 0 to 3
# (0 locally, 1 behind Railway; with 0 all login attempts share one rate-limit bucket)
TRUST_PROXY_HOPS=
# Extra hosts (comma list, exact host[:port] or full URL, no wildcards) allowed to post forms, e.g. a tunnel host
ALLOWED_ORIGINS=
# Secure session cookie; defaults to true when NODE_ENV=production. Set false for http on localhost.
COOKIE_SECURE=
# Required (true) alongside COOKIE_SECURE=false under NODE_ENV=production (e.g. `next start` on http://localhost);
# without it the app refuses to start with an insecure cookie.
ALLOW_INSECURE_COOKIE=
# Dev only: hostnames (comma list, e.g. the PC's LAN IP) allowed to open `next dev` from a phone
DEV_ORIGINS=
